# Copy to .env.local for local development; never commit credentials.
DATABASE_MODE=pglite
PGLITE_PATH=.local/database
APP_ORIGIN=http://localhost:3002
# Cloud: remove DATABASE_MODE/PGLITE_PATH; set the private server variables below.
# DATABASE_URL=postgresql://app_user:encoded_password@db_host:5432/path_edu
# DATABASE_TLS=true
# DATABASE_CA=trusted CA certificate, if required (\\n accepted)
# APP_ORIGIN=https://your-stable-teaching-domain
# One-time bootstrap command only, never keep this in deployment settings:
# BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_PASSWORD=use-a-unique-12-or-more-character-password
# INSTITUTION_NAME=六院教学试用
